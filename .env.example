# Festival Mbois Intelligence Platform
# Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_NAME=Festival Mbois Intelligence Platform

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=festival_mbois
DB_USER=mbois_user
DB_PASSWORD=mbois_password_2026
DB_SSL=false
DB_LOGGING=true

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mbois_redis_2026
REDIS_DB=0

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# BACKEND API
# ============================================
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ============================================
# WORKERS
# ============================================
WORKER_INTERVAL=900000
WORKER_BATCH_SIZE=100
WORKER_MAX_RETRIES=3

# Instagram Worker
INSTAGRAM_ENABLED=true
INSTAGRAM_SESSION_ID=

# TikTok Worker
TIKTOK_ENABLED=true
TIKTOK_SESSION_ID=

# Website Scraper
WEBSITE_ENABLED=true
WEBSITE_URLS=https://example.com

# Twitter/X Worker
TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=

# ============================================
# SENTIMENT ANALYSIS
# ============================================
SENTIMENT_ENABLED=true
SENTIMENT_MODEL=rule-based
SENTIMENT_THRESHOLD=0.5

# AI Model (Future)
AI_MODEL_PATH=./models/indobert
AI_API_URL=http://localhost:8000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ============================================
# MONITORING
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=your-encryption-key-32-characters
COOKIE_SECRET=your-cookie-secret-key

# ============================================
# EMAIL (Optional - for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@festivalmbois.com

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

