# Festival Mbois Intelligence Platform
# Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_NAME=Festival Mbois Intelligence Platform

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=festival_mbois
DB_USER=mbois_user
DB_PASSWORD=mbois_password_2026
DB_SSL=false
DB_LOGGING=true

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mbois_redis_2026
REDIS_DB=0

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# BACKEND API
# ============================================
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ============================================
# WORKERS (Backend & Python Workers)
# ============================================
WORKER_INTERVAL=0
WORKER_BATCH_SIZE=100
WORKER_MAX_RETRIES=3
# Batas waktu job worker dianggap stale (ms). Default: 30 menit (1800000).
WORKER_STALE_TIMEOUT_MS=7200000

# Instagram Worker (Instaloader - PRIMARY provider)
# Workers read their own config from workers/.env (see workers/.env.example).
# INSTAGRAM_SESSION_FILE points to the Instaloader session created from cookies.
# NOTE: Instagram password is NEVER stored here. Enter manually when creating session.
INSTAGRAM_ENABLED=true
INSTAGRAM_SESSION_FILE=./instagram_session
INSTAGRAM_COOKIES_FILE=./cookies.txt
INSTAGRAM_MAX_POSTS=50
INSTAGRAM_USERNAME=
# Graph API is a FUTURE provider only - keep disabled for now
INSTAGRAM_USE_GRAPH_API=false

# TikTok Worker (Apify Actor clockworks/tiktok-scraper - pay-per-event, TANPA langganan bulanan)
# Credential & config lengkap ada di workers/.env (jangan di-commit).
# TIKTOK_AUTO_SCRAPE=false -> scheduler otomatis tidak menjalankan TikTok.
# Worker tetap bisa dijalankan manual: venv\Scripts\python -m tiktok.worker
TIKTOK_ENABLED=true
TIKTOK_AUTO_SCRAPE=false
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
TIKTOK_MAX_POSTS_PER_KEYWORD=5
TIKTOK_MAX_KEYWORDS_PER_RUN=1
TIKTOK_MAX_CHARGE_PER_RUN=0.50
TIKTOK_RUN_TIMEOUT_SECONDS=600
TIKTOK_MAX_RETRIES=1
TIKTOK_DELAY_SECONDS=3

# Website Scraper (real scraping via RSS feed situs berita Indonesia + Bing News + Google News)
WEBSITE_ENABLED=true
WEBSITE_URLS=
WEBSITE_RSS_FEEDS=
RSS_ENABLED=true
WEBSITE_MAX_ARTICLES_PER_KEYWORD=10
WEBSITE_MAX_AGE_DAYS=30
WEBSITE_TIMEOUT_SECONDS=20
WEBSITE_FETCH_DELAY_SECONDS=1.5
WEBSITE_GOOGLE_NEWS_ENABLED=true
WEBSITE_GOOGLE_NEWS_MAX_PER_QUERY=15
WEBSITE_GOOGLE_NEWS_TIME_FILTER=30d
WEBSITE_GOOGLE_RESOLVE_CONCURRENCY=4
WEBSITE_BING_MAX_RESULTS=50
WEBSITE_USE_PLAYWRIGHT=true
WEBSITE_PLAYWRIGHT_TIMEOUT_MS=20000
WEBSITE_DOWNLOAD_RETRIES=2
WEBSITE_RETRY_BASE_DELAY_SECONDS=2.0

# Threads Worker (Playwright + storage state session, browser automation - BUKAN Meta Graph API)
# Default false: tanpa session valid worker TIDAK membuka browser.
# Backend menghormati flag ini: POST /scraping/run/threads dan scheduler 6 jam
# akan menolak (HTTP 400) jika bernilai false.
THREADS_ENABLED=false
THREADS_HEADLESS=true
THREADS_SESSION_DIR=./data/sessions/threads
THREADS_COOKIES_FILE=./data/sessions/threads/cookies.txt
THREADS_STORAGE_STATE_FILE=./data/sessions/threads/storage.json
THREADS_TIMEOUT_MS=30000
THREADS_SLOW_MO_MS=0
THREADS_VIEWPORT=1280,800
THREADS_RETRY_COUNT=1
THREADS_RETRY_BASE_DELAY_SECONDS=2.0
THREADS_MAX_POSTS=10
THREADS_LIVE_TEST=false

# Facebook Worker (public pages, Playwright + cookie Netscape - TANPA username/password)
# Cookies wajib ada: salin workers/facebook_cookies.txt.example menjadi facebook_cookies.txt
# lalu tempel cookie ekspor Anda (jangan di-commit).
FACEBOOK_ENABLED=true
FACEBOOK_COOKIES_FILE=./facebook_cookies.txt
FACEBOOK_STORAGE_STATE_FILE=./facebook_state.json
FACEBOOK_HEADLESS=true
FACEBOOK_TIMEOUT_MS=30000
FACEBOOK_MAX_POSTS=20
FACEBOOK_MAX_PAGES=5
FACEBOOK_MAX_SCROLLS=10
FACEBOOK_SCROLL_DELAY_SECONDS=2.0
FACEBOOK_REQUEST_DELAY_SECONDS=1.5
FACEBOOK_RETRY_COUNT=3
FACEBOOK_RETRY_BASE_DELAY_SECONDS=2.0
# Daftar halaman PUBLIK yang di-scrape, dipisahkan koma.
# Format bebas: URL penuh, nama halaman, atau @nama.
FACEBOOK_PAGES=https://www.facebook.com/YourPublicPage

# X (Twitter) Worker - provider: playwright (development) / api (production)
# Cookie: simpan ekspor cookie Netscape (dalam keadaan LOGIN ke x.com) di
# workers/twitter/twitter_cookies.txt - jangan di-commit.
TWITTER_ENABLED=false
TWITTER_PROVIDER=playwright
TWITTER_BEARER_TOKEN=
TWITTER_MAX_POSTS_PER_KEYWORD=20
TWITTER_EXCLUDE_RETWEETS=true
TWITTER_LANG=
TWITTER_TIMEOUT_SECONDS=30
TWITTER_MAX_RETRIES=3
TWITTER_DELAY_SECONDS=2
TWITTER_COOKIES_FILE=./twitter/twitter_cookies.txt
TWITTER_STORAGE_STATE_FILE=./twitter/twitter_state.json
TWITTER_HEADLESS=true
TWITTER_MAX_SCROLLS=10

# Worker Orchestrator
WORKER_MODE=parallel
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=60
WORKER_SCHEDULED=false
WORKER_SCHEDULE_INTERVAL=3600

# Scraper behaviour
SCRAPER_TIMEOUT=30
SCRAPER_DELAY_MS=1500
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
PLAYWRIGHT_ENABLED=false

# ============================================
# SENTIMENT ANALYSIS
# ============================================
SENTIMENT_ENABLED=true
SENTIMENT_MODEL=rule-based
SENTIMENT_THRESHOLD=0.5

# AI Model (Future)
AI_MODEL_PATH=./models/indobert
AI_API_URL=http://localhost:8000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ============================================
# MONITORING
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=your-encryption-key-32-characters
COOKIE_SECRET=your-cookie-secret-key

# ============================================
# EMAIL (Optional - for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@festivalmbois.com

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=