# Festival Mbois Workers - Environment Configuration
# Copy this file to .env and fill in your values

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=festival_mbois
DB_USER=mbois_user
DB_PASSWORD=mbois_password_2026

# Instagram Worker
INSTAGRAM_MAX_POSTS=50
INSTAGRAM_SESSION_FILE=./instagram_session
INSTAGRAM_USERNAME=

# TikTok Worker
TIKTOK_MAX_VIDEOS=50

# Website Scraper
WEBSITE_URLS=

# Worker Orchestrator
WORKER_MODE=sequential
