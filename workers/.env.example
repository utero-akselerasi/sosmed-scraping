# Festival Mbois Workers - Environment Configuration
# Copy this file to .env and fill in your values.
# This template mirrors the keys currently read by the worker code
# (run_all.py, instagram/worker.py, tiktok/worker.py, website/scraper.py, shared/database.py).

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=festival_mbois
DB_USER=mbois_user
DB_PASSWORD=change_me

# Instagram Worker (Instaloader is PRIMARY provider for dev/testing)
# NOTE: The Instagram password is NEVER stored here. It is entered manually
# once when creating the Instaloader session (see instagram/create_session.py).
INSTAGRAM_ENABLED=true
INSTAGRAM_USERNAME=
INSTAGRAM_MAX_POSTS=50
INSTAGRAM_SESSION_FILE=./instagram_session
INSTAGRAM_COOKIES_FILE=./cookies.txt
# Graph API is a FUTURE provider only - keep disabled for now
INSTAGRAM_USE_GRAPH_API=false

# TikTok Worker (Apify Actor clockworks/tiktok-scraper - pay-per-event, TANPA langganan bulanan)
# NOTE: Isi APIFY_TOKEN di .env lokal (dari console.apify.com -> Settings -> API & Integrations).
# Jangan pernah commit token asli.
# TIKTOK_AUTO_SCRAPE=false -> run_all.py / scheduler otomatis TIDAK menjalankan TikTok.
# Worker tetap bisa dijalankan manual: venv\Scripts\python -m tiktok.worker
TIKTOK_ENABLED=true
TIKTOK_AUTO_SCRAPE=false
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
TIKTOK_MAX_POSTS_PER_KEYWORD=5
TIKTOK_MAX_KEYWORDS_PER_RUN=1
TIKTOK_MAX_CHARGE_PER_RUN=0.50
TIKTOK_RUN_TIMEOUT_SECONDS=600
TIKTOK_MAX_RETRIES=1
TIKTOK_DELAY_SECONDS=3

# Website Scraper (RSS + Bing News + Google News)
WEBSITE_ENABLED=true
WEBSITE_URLS=
WEBSITE_RSS_FEEDS=
RSS_ENABLED=true
WEBSITE_MAX_ARTICLES_PER_KEYWORD=10
WEBSITE_MAX_AGE_DAYS=30
WEBSITE_TIMEOUT_SECONDS=20
WEBSITE_FETCH_DELAY_SECONDS=1.5
WEBSITE_GOOGLE_NEWS_ENABLED=true
WEBSITE_GOOGLE_NEWS_MAX_PER_QUERY=15
WEBSITE_GOOGLE_NEWS_TIME_FILTER=30d
WEBSITE_GOOGLE_RESOLVE_CONCURRENCY=4
WEBSITE_BING_MAX_RESULTS=50
WEBSITE_USE_PLAYWRIGHT=true
WEBSITE_PLAYWRIGHT_TIMEOUT_MS=20000
WEBSITE_DOWNLOAD_RETRIES=2
WEBSITE_RETRY_BASE_DELAY_SECONDS=2.0

# Facebook Worker (public pages, Playwright + cookie Netscape - TANPA username/password)
# NOTE: Variabel FACEBOOK_* bisa ditaruh di file ini ATAU di .env / .env.local
# level proyek (config.py membaca keduanya).
# Cookies: salin facebook_cookies.txt.example menjadi facebook_cookies.txt
# lalu tempel cookie ekspor Anda (jangan di-commit).
FACEBOOK_ENABLED=true
FACEBOOK_COOKIES_FILE=./facebook_cookies.txt
FACEBOOK_STORAGE_STATE_FILE=./facebook_state.json
FACEBOOK_HEADLESS=true
FACEBOOK_TIMEOUT_MS=30000
FACEBOOK_MAX_POSTS=20
FACEBOOK_MAX_PAGES=5
FACEBOOK_MAX_SCROLLS=10
FACEBOOK_SCROLL_DELAY_SECONDS=2.0
FACEBOOK_REQUEST_DELAY_SECONDS=1.5
FACEBOOK_RETRY_COUNT=3
FACEBOOK_RETRY_BASE_DELAY_SECONDS=2.0
# Daftar halaman PUBLIK yang di-scrape, dipisahkan koma.
FACEBOOK_PAGES=https://www.facebook.com/YourPublicPage

# Scraper behaviour
SCRAPER_TIMEOUT=30
SCRAPER_DELAY_MS=1500
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
PLAYWRIGHT_ENABLED=false

# Threads Worker (browser automation - session lokal, BUKAN Meta Graph API)
# Autentikasi: storage state Playwright (data/sessions/threads/storage.json)
# dibuat dari login manual (threads/login.py) ATAU import cookie Netscape
# (threads/import_cookies.py). TANPA token/password di env.
# THREADS_ENABLED=true adalah switch runtime worker (dibaca dari workers/.env
# saat menjalankan `python threads/worker.py`). Tetap false hanya jika ingin
# worker melewati (skip) scraping Threads tanpa membuka browser.
THREADS_ENABLED=true
THREADS_HEADLESS=true
THREADS_SESSION_DIR=./data/sessions/threads
THREADS_COOKIES_FILE=./data/sessions/threads/cookies.txt
THREADS_STORAGE_STATE_FILE=./data/sessions/threads/storage.json
THREADS_TIMEOUT_MS=30000
# Development: browser terlihat + lambat supaya bisa di-debug
THREADS_SLOW_MO_MS=0
THREADS_VIEWPORT=1280,800
THREADS_RETRY_COUNT=1
THREADS_RETRY_BASE_DELAY_SECONDS=2.0
# Batas post yang dikumpulkan per keyword saat scraping (pola INSTAGRAM_MAX_POSTS;
# halaman search Threads me-render ~5-9 link, jadi 10 sudah menangkap semuanya)
THREADS_MAX_POSTS=10
# Test publish asli (wajib false di CI; true hanya manual)
THREADS_LIVE_TEST=false

# Worker Orchestrator
WORKER_MODE=parallel
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=60
WORKER_SCHEDULED=false
WORKER_SCHEDULE_INTERVAL=3600

# X (Twitter) Worker - provider: playwright (development) / api (production)
# NOTE: Isi TWITTER_BEARER_TOKEN di .env lokal dengan token dari X Developer
# Portal. Jangan pernah commit token asli.
# Cookie: simpan ekspor cookie Netscape (dalam keadaan LOGIN ke x.com) di
# workers/twitter/twitter_cookies.txt - jangan di-commit.
TWITTER_ENABLED=true
TWITTER_PROVIDER=playwright
TWITTER_BEARER_TOKEN=
TWITTER_MAX_POSTS_PER_KEYWORD=20
TWITTER_EXCLUDE_RETWEETS=true
TWITTER_LANG=
TWITTER_TIMEOUT_SECONDS=30
TWITTER_MAX_RETRIES=3
TWITTER_DELAY_SECONDS=2
# Playwright provider (development) - cookie sesi Netscape dari x.com
TWITTER_COOKIES_FILE=./twitter/twitter_cookies.txt
TWITTER_STORAGE_STATE_FILE=./twitter/twitter_state.json
TWITTER_HEADLESS=true
TWITTER_MAX_SCROLLS=10
